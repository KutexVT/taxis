# ====== Base de datos ======
# PostgreSQL local (ajusta usuario/clave segun tu instalacion)
DATABASE_URL="postgresql://taxi:taxi@localhost:5432/taxi_platform?schema=public"

# Credenciales para docker-compose (servicio postgres)
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi
POSTGRES_DB=taxi_platform

# ====== API ======
API_PORT=4000
NODE_ENV=development

# Secretos JWT (cambialos en produccion por valores largos y aleatorios)
JWT_ACCESS_SECRET="cambia-esto-access-secret"
JWT_REFRESH_SECRET="cambia-esto-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Origen permitido para CORS (frontend)
WEB_ORIGIN="http://localhost:3000"

# Super admin inicial (usado por el seed)
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"
SEED_SUPERADMIN_NAME="Super Administrador"

# ====== Web (Next.js) ======
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
