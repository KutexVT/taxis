# ====== Produccion (docker-compose.prod.yml) ======
# Copia a .env.prod y rellena con valores reales y SECRETOS FUERTES.

# URL publica de la plataforma (lo que abre el navegador). Mismo origen para web y API
# porque nginx proxynea /api y /socket.io. Ej: https://taxi.tudominio.com
PUBLIC_BASE_URL=http://TU_IP_O_DOMINIO
WEB_ORIGIN=http://TU_IP_O_DOMINIO

# Base de datos (servicio 'postgres' del compose)
POSTGRES_USER=taxi
POSTGRES_PASSWORD=PON_UNA_CLAVE_FUERTE
POSTGRES_DB=taxi_platform
DATABASE_URL=postgresql://taxi:PON_UNA_CLAVE_FUERTE@postgres:5432/taxi_platform?schema=public

# Secretos JWT — genera valores largos aleatorios, p.ej: openssl rand -base64 48
JWT_ACCESS_SECRET=CAMBIA_ESTO
JWT_REFRESH_SECRET=CAMBIA_ESTO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Super admin inicial (creado por el seed; cambia la clave tras el primer ingreso)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=CAMBIA_ESTO
SEED_SUPERADMIN_NAME=Super Administrador
